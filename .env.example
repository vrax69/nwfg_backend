# MySQL Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=admin
DB_PASS=admin
DB_ROOT_PASSWORD=root
DB_NAME=nwfg_platform

# Redpanda / Kafka
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=nwfg-platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Service Ports
PORT_SERVER_RATES=4002
PORT_USER_AUTH=4001
PORT_FRONTEND=3000

# Auth Secrets (replace in production)
JWT_SECRET=development_secret_key_change_me
REFRESH_TOKEN_SECRET=development_refresh_secret_key_change_me

# External Services (if any)
# API_KEY_EXAMPLE=
